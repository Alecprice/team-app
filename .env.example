# Team APP V1.10 environment reference
#
# IMPORTANT: The primary Cloudflare Pages browser client uses Neon Managed Auth
# + the Neon Data API endpoints configured in client/cloud-entry.js. It does not
# require the legacy Node/Express secrets below simply to build or serve `dist/`.
#
# The variables in this file belong to the retained Node/Express compatibility
# service and future secret-backed worker/provider integrations. Do not copy all
# of them into Cloudflare Pages unless a specific runtime actually consumes them.

# Legacy Node/Express database connection (Neon pooled connection string)
DATABASE_URL=

# Legacy self-hosted Better Auth compatibility service only.
# Do not run this as a second authoritative identity provider beside Neon Managed Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080

# Legacy application-layer encryption key for sensitive server-side compatibility fields.
# Generate: openssl rand -base64 32
TEAM_APP_DATA_KEY=

# Future/legacy email provider integration.
RESEND_API_KEY=
EMAIL_FROM=Team APP <team@example.com>

# Legacy/future object-storage service path. Local disk is development-only.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.team-app-uploads
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# Future closed-app Web Push provider path.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Future/legacy scheduled job protection where an HTTP cron endpoint is used.
CRON_SECRET=

# Legacy Node/Express service tuning.
PORT=8080
NODE_ENV=development
TEAM_APP_MAX_UPLOAD_MB=25
TEAM_APP_MAX_TEAM_STORAGE_MB=500
