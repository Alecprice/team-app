# Core database (Neon pooled connection string)
DATABASE_URL=

# Better Auth uses its own `auth` PostgreSQL schema.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080

# Separate 32-byte base64 key for application-level encryption of sensitive fields.
# Generate: openssl rand -base64 32
TEAM_APP_DATA_KEY=

# Email. If omitted, development mode logs email links instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=Team APP <team@example.com>

# Object storage. Local disk is allowed only in development.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.team-app-uploads
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protect scheduled weather-monitor endpoint.
CRON_SECRET=

# Optional service tuning
PORT=8080
NODE_ENV=development
TEAM_APP_MAX_UPLOAD_MB=25
