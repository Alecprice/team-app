{
  "name": "team-app",
  "version": "1.10.0",
  "private": true,
  "description": "Team APP mobile-first multi-sport coaching and team operations PWA using Cloudflare Pages/Workers and Neon.",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve-static.js",
    "start": "node scripts/serve-static.js",
    "build": "node scripts/build-cloudflare.js",
    "build:client": "node server/scripts/build-client.js",
    "test": "bash tests/run-all.sh && node --test server/tests/*.test.js",
    "test:service": "node --test server/tests/*.test.js",
    "build:cloudflare": "node scripts/build-cloudflare.js",
    "verify:release": "npm run build && node scripts/verify-release.mjs",
    "verify:worker": "npx wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .wrangler-dry-run",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "gate": "bash scripts/local-release-gate.sh"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.7.0-beta"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "4.123.0"
  }
}
