{
  "name": "team-app",
  "version": "1.9.0",
  "private": true,
  "description": "Team APP mobile-first multi-sport coaching and team operations PWA using Vercel and Neon.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve-static.js",
    "start": "node scripts/serve-static.js",
    "build": "node scripts/build-vercel.js",
    "build:client": "node server/scripts/build-client.js",
    "test": "bash tests/run-all.sh && node --test server/tests/*.test.js",
    "test:service": "node --test server/tests/*.test.js",
    "build:vercel": "node scripts/build-vercel.js"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
